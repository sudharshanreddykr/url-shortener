# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# URL Shortener Configs
DEFAULT_LINK_TTL_DAYS=30
CLEANUP_INTERVAL_MS=3600000

# Rate Limiting Configs
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10

# Database Configuration (PostgreSQL)
# Either provide the full connection string:
DATABASE_URL=postgres://user:password@localhost:5432/dbname
# Optional: Read Replica URL for SQL scaling:
# DATABASE_READ_URL=postgres://user:password@localhost:5433/dbname

# Or provide the discrete variables:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=url_shortener
DB_LOGGING=false

# Optional: Discrete Read Replica variables for SQL scaling:
# DB_READ_HOST=localhost
# DB_READ_PORT=5433
# DB_READ_USER=postgres
# DB_READ_PASSWORD=postgres

# Database Connection Pool Settings
DB_POOL_MAX=10
DB_POOL_MIN=0

# Redis Configuration
# Either provide the full Redis URL:
REDIS_URL=redis://localhost:6379
# Or provide the discrete variables:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# Background Worker Settings
RUN_WORKER=true
